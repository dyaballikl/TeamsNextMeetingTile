<Window x:Class="TeamsNextMeetingTile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teams Next Meeting Tile"
        Width="230"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Window.ContextMenu>
        <ContextMenu Background="#292929" Foreground="#FFFFFF" BorderBrush="#444444">
            <MenuItem x:Name="MenuVersionHeader" Header="v1.2.0" IsEnabled="False" FontWeight="SemiBold"/>
            <Separator Background="#3D3D3D"/>
            <MenuItem Header="⚙ Settings &amp; Upcoming Meetings..." Click="MenuSettings_Click"/>
            <MenuItem Header="☁ Open M365 Calendar Window (Sign In / Verify)" Click="MenuOpenM365_Click"/>
            <MenuItem Header="↻ Sync Calendar Now" Click="MenuSyncNow_Click"/>
            <Separator Background="#3D3D3D"/>
            <MenuItem Header="📌 Snap Above 'Quick views' (Default)" Click="MenuSnapDefault_Click"/>
            <MenuItem x:Name="MenuDockToggle" Header="✓ Dock to Microsoft Teams Window" Click="MenuDockToggle_Click"/>
            <MenuItem x:Name="MenuCollapseToggle" Header="Collapse / Expand Tile" Click="BtnCollapse_Click"/>
            <Separator Background="#3D3D3D"/>
            <MenuItem Header="✕ Quit Teams Next Meeting Tile" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Outer Card matching Microsoft Teams Dark Mode (#292929 card on #1F1F1F sidebar) -->
    <Border x:Name="CardBorder"
            Background="#292929"
            BorderBrush="#3D3D3D"
            BorderThickness="1"
            CornerRadius="7"
            Margin="2"
             Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Urgency Accent Bar -->
            <Border x:Name="AccentStripe"
                    Grid.Column="0"
                    Background="#5B5FC7"
                    CornerRadius="6,0,0,6"/>

            <!-- Main Tile Content -->
            <Grid Grid.Column="1" Margin="8,6,7,6">
                <!-- EXPANDED VIEW -->
                <StackPanel x:Name="ExpandedPanel" Visibility="Visible">
                    <!-- Row 1: Header Label + DHM Countdown Pill + Controls -->
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Dot + Header -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#7F85F5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtHeaderStatus"
                                       Text="NEXT"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="#A6A6A6"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- DHM Countdown Pill -->
                        <Border x:Name="CountdownBadge"
                                Grid.Column="1"
                                Background="#33344A"
                                BorderBrush="#5B5FC7"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="5,0,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ToolTip="Time remaining until meeting start (Days Hours Minutes)">
                            <TextBlock x:Name="TxtDhmCountdown"
                                       Text="0d 0h 0m"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#E8EAFF"/>
                        </Border>

                        <!-- Collapse Button -->
                        <Button Grid.Column="2"
                                Content="▾"
                                Click="BtnCollapse_Click"
                                ToolTip="Collapse / Expand tile"
                                Background="Transparent"
                                Foreground="#9E9E9E"
                                BorderThickness="0"
                                Padding="3,0"
                                FontSize="10"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>

                        <!-- Settings Button -->
                        <Button Grid.Column="3"
                                Content="⚙"
                                Click="BtnSettings_Click"
                                ToolTip="Settings &amp; Calendar Sync"
                                Background="Transparent"
                                Foreground="#9E9E9E"
                                BorderThickness="0"
                                Padding="3,0"
                                FontSize="10.5"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 2: Meeting Title -->
                    <TextBlock x:Name="TxtMeetingTitle"
                               Text="Syncing your calendar..."
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,4"
                               ToolTip="Syncing your calendar..."/>

                    <!-- Row 3: Start Time + Cycle/Join Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Start Time -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕒" FontSize="10" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtStartTime"
                                       Text="Start: --:--"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#D0D0D0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Prev / Next Meeting Cycle Buttons -->
                        <StackPanel x:Name="CyclePanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0" Visibility="Collapsed">
                            <Button Content="‹" Click="BtnPrevMeeting_Click" ToolTip="Previous upcoming meeting"
                                    Background="#353535" Foreground="#CCCCCC" BorderThickness="0" Padding="4,0" FontSize="11" Cursor="Hand" Margin="0,0,2,0"/>
                            <Button Content="›" Click="BtnNextMeeting_Click" ToolTip="Next upcoming meeting"
                                    Background="#353535" Foreground="#CCCCCC" BorderThickness="0" Padding="4,0" FontSize="11" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Action Button (Join / Sign In / Sync) -->
                        <Button x:Name="BtnPrimaryAction"
                                Grid.Column="2"
                                Content="Join"
                                Click="BtnPrimaryAction_Click"
                                Background="#5B5FC7"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                FontSize="10.5"
                                BorderThickness="0"
                                Padding="8,2"
                                Cursor="Hand"
                                Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- COLLAPSED SLIM VIEW (Still shows Start Time + DHM Countdown!) -->
                <Grid x:Name="CollapsedPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCollapsedStart" Grid.Column="0" Text="11:30 AM" FontSize="10.5" FontWeight="SemiBold" Foreground="#D6D6D6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtCollapsedDhm" Grid.Column="1" Text="0d 0h 0m" FontSize="10.5" FontWeight="Bold" Foreground="#8B8FF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtCollapsedTitle" Grid.Column="2" Text="Meeting" FontSize="10.5" Foreground="#B0B0B0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="▸" Click="BtnCollapse_Click" ToolTip="Expand tile"
                            Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Padding="4,0" FontSize="10" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
