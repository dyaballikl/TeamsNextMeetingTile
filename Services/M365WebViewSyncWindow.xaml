<Window x:Class="TeamsNextMeetingTile.Services.M365WebViewSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Microsoft 365 Calendar Sync (Outlook Web)"
        Width="1120" Height="760"
        Background="#1F1F1F"
        WindowStartupLocation="Manual"
        Left="-20000" Top="-20000"
        ShowInTaskbar="False"
        ShowActivated="False"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#292929" BorderBrush="#3D3D3D" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRefreshPage" Content="↻ Reload Calendar" Click="BtnRefreshPage_Click"
                            Background="#383838" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="BtnHideBackground" Content="Run in Background (Hide)" Click="BtnHideBackground_Click"
                            Background="#5B5FC7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="12,5" Cursor="Hand"/>
                </StackPanel>
                <TextBlock x:Name="TxtSyncBanner"
                           Text="Once your Outlook Calendar is visible below, meetings sync automatically in the background."
                           Foreground="#E0E0E0" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="CalendarWebView" Grid.Row="1" DefaultBackgroundColor="#1F1F1F"/>
    </Grid>
</Window>
