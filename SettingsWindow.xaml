<Window x:Class="TeamsNextMeetingTile.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teams Next Meeting Tile — Settings &amp; Calendar Sync"
        Width="680" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F1F"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4E4E4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Section 1: Docking & Position -->
        <Border Grid.Row="0" Background="#292929" CornerRadius="6" BorderBrush="#3A3A3A" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="1. Teams Window Docking &amp; Position" FontWeight="SemiBold" FontSize="14" Foreground="#8B8FF8" Margin="0,0,0,6"/>
                <WrapPanel Orientation="Horizontal">
                    <CheckBox x:Name="ChkDockToTeams" Content="Dock to Microsoft Teams window" Margin="0,4,18,4" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="ChkAutoHideCovered" Content="Auto-hide when Teams is minimized or covered" Margin="0,4,18,4" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="ChkLockPosition" Content="Lock drag position" Margin="0,4,18,4" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="ChkStartWithWindows" Content="Start automatically with Windows (auto-shows when Teams opens)" Margin="0,4,0,4" Checked="ChkStartWithWindows_Changed" Unchecked="ChkStartWithWindows_Changed"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Quick Presets:" VerticalAlignment="Center" Foreground="#B8B8B8" Margin="0,0,8,0" FontSize="12"/>
                    <Button Content="Above 'Quick views' (Sidebar)" Click="BtnPresetQuickViews_Click" Margin="0,0,6,0" Background="#5B5FC7" BorderThickness="0"/>
                    <Button Content="Chat Header Bar" Click="BtnPresetChatHeader_Click" Margin="0,0,6,0"/>
                    <Button Content="Top Title Bar" Click="BtnPresetTitleBar_Click" Margin="0,0,14,0"/>
                    <TextBlock Text="Width:" VerticalAlignment="Center" Foreground="#B8B8B8" Margin="0,0,6,0" FontSize="12"/>
                    <TextBox x:Name="TxtTileWidth" Width="54" Text="230" LostFocus="TxtTileWidth_LostFocus"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Section 2: Calendar Sync Sources -->
        <Border Grid.Row="1" Background="#292929" CornerRadius="6" BorderBrush="#3A3A3A" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="2. Automatic Calendar Sync (Zero File Exports)" FontWeight="SemiBold" FontSize="14" Foreground="#8B8FF8" Margin="0,0,0,6"/>

                <!-- M365 WebView2 SSO -->
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="ChkEnableM365" Content="Microsoft 365 / New Outlook Live Sync (WebView2 SSO)" FontWeight="SemiBold" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <TextBlock x:Name="TxtM365Status" Text="Status: Active" Foreground="#A8A8A8" FontSize="11.5" Margin="22,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open M365 Calendar Window" Click="BtnOpenM365Window_Click" Margin="6,0" VerticalAlignment="Center" Background="#5B5FC7" BorderThickness="0"/>
                    <Button Grid.Column="2" Content="↻ Sync Now" Click="BtnSyncNow_Click" VerticalAlignment="Center"/>
                </Grid>

                <!-- Optional ICS Subscription URL -->
                <TextBlock Text="Optional Live ICS Feed URL (Outlook Settings → Calendar → Shared calendars → Publish a calendar → ICS link):"
                           Foreground="#B8B8B8" FontSize="11.5" Margin="0,2,0,4"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtIcsUrl" Grid.Column="0" Margin="0,0,8,0" ToolTip="Paste a permanent https://.../calendar.ics URL here"/>
                    <Button Grid.Column="1" Content="Save &amp; Fetch ICS" Click="BtnSaveIcs_Click"/>
                </Grid>

                <CheckBox x:Name="ChkEnableClassicCom" Content="Also read Classic Outlook MAPI if Classic Outlook is running" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
            </StackPanel>
        </Border>

        <!-- Section 3: Upcoming Meetings List -->
        <Border Grid.Row="2" Background="#292929" CornerRadius="6" BorderBrush="#3A3A3A" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="3. Upcoming Detected Meetings" FontWeight="SemiBold" FontSize="14" Foreground="#8B8FF8"/>
                    <TextBlock x:Name="TxtMeetingCount" Text="0 meetings" Foreground="#A0A0A0" FontSize="12" HorizontalAlignment="Right"/>
                </DockPanel>

                <ListBox x:Name="LstMeetings"
                         Grid.Row="1"
                         Background="#161616"
                         Foreground="#FFFFFF"
                         BorderBrush="#383838"
                         BorderThickness="1"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StartDisplay}" Foreground="#8B8FF8" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding DhmDisplay}" Foreground="#F2C811" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Source}" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                                <Button Grid.Column="4" Content="✕" Tag="{Binding Id}" Visibility="{Binding DeleteVisibility}"
                                        Click="BtnDeleteManual_Click" Padding="5,1" FontSize="10" Background="#4A2525" BorderThickness="0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Section 4: Quick Pin Custom Meeting -->
        <Border Grid.Row="3" Background="#292929" CornerRadius="6" BorderBrush="#3A3A3A" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="4. Quick Pin a Custom Meeting / Test Reminder" FontWeight="SemiBold" FontSize="13" Foreground="#CFCFCF" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNewTitle" Grid.Column="0" Margin="0,0,6,0" Text="Sprint Standup / Triage" ToolTip="Meeting Title"/>
                    <TextBox x:Name="TxtNewStart" Grid.Column="1" Margin="0,0,6,0" ToolTip="Start Date &amp; Time (yyyy-MM-dd HH:mm)"/>
                    <TextBox x:Name="TxtNewJoinUrl" Grid.Column="2" Margin="0,0,6,0" Text="" ToolTip="Optional Teams Join Link"/>
                    <Button Grid.Column="3" Content="+ Add Meeting" Click="BtnAddManual_Click" Background="#5B5FC7" BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Quit Tile App" Click="BtnQuitApp_Click" Background="#6E2626" BorderThickness="0" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtVersionFooter"
                       Grid.Column="1"
                       Text="v1.2.0 • Published: 2026-11-02"
                       Foreground="#8E8E8E"
                       FontSize="11.5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Close Settings" Click="BtnClose_Click" HorizontalAlignment="Right" Width="120" Background="#5B5FC7" BorderThickness="0" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
